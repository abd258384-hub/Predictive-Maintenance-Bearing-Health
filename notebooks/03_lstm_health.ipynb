   "id": "86074dd1",
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(2, 2, figsize=(13, 8))\n",
    "for ax, (name, (yt, yp)) in zip(axes.ravel(), preds.items()):\n",
    "    ax.plot(yt, label=\"actual\", lw=2); ax.plot(yp, label=\"predicted\", alpha=.8)\n",
    "    ax.set_title(name, fontsize=9); ax.set_xlabel(\"sequence (time)\"); ax.set_ylabel(\"health (0-100)\"); ax.legend()\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7799475a",
